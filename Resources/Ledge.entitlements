<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened Runtime requirements for Developer ID + notarization. -->
    <!-- Outbound network for the Bitcoin module (CoinGecko) and any future appcast/Sparkle update checks. -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- AppleScript control of Music + Spotify for the Now Playing module.
         AppleEvents are restricted under Hardened Runtime; this entitlement
         allows them. macOS still prompts the user for per-app Automation
         permission the first time we target each source app. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>

    <!-- Sparkle 2: lets the host app load Sparkle.framework even when the
         framework's signing identity differs from the host's (true for
         ad-hoc dev builds; for Developer ID releases we re-sign Sparkle
         with our identity in scripts/release.sh). -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Ledge is NOT sandboxed in v1. Direct download via Developer ID,
         not Mac App Store, so we don't need (and don't want) the sandbox
         restrictions yet. If we ever ship to the App Store, set
         com.apple.security.app-sandbox = true and revisit file access. -->
</dict>
</plist>
